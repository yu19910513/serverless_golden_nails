# Supabase URL and Anon Key
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# JWT
JWT_SECRET=this_is_a_very_long_and_random_secret_string

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+100000000000

# Email (Example for Gmail)
APP_PASSWORD="xxxx xxxx xxxx xxxx"
BUSINESS_EMAIL="xxxx@gmail.com"
STORE_EMAIL="xxxx@gmail.com"
OWNER_EMAIL="xxxx@gmail.com"

ALLOWED_REFERRERS="http://localhost:5173"

# --- Admin Token Expiration ---
#
# Controls token lifetime for users with 'admin_privilege'.
#
# * To set a specific duration: Use a string like "15m" or "1h".
# * To make tokens NEVER expire: Set to the string "null" OR comment out the line entirely.
#
# WARNING: An empty string ("") will also create a non-expiring token,
# but using "null" or commenting it out is clearer.
#
ADMIN_TOKEN_EXPIRATION="null"

#
# --- Customer Token Expiration ---
#
# Controls token lifetime for regular (non-admin) customers.
#
# * To set a specific duration: Use a string like "2h" or "7d".
# * To use the default (e.g., "2h"): Comment out this line entirely.
#
# CRITICAL: Do NOT set to an empty string (""). An empty string will
# bypass the default and create a token that NEVER EXPIRES.
# Use "null" if you explicitly want non-expiring customer tokens.
#
CUSTOMER_TOKEN_EXPIRATION="2h"